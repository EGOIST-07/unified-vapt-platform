# Auth
JWT_SECRET=change_me_long_random_jwt_secret
JWT_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me_admin_password

# Backend/Worker
REDIS_URL=redis://redis:6379/0
CORS_ORIGIN=*
SCAN_OUTPUT_DIR=/tmp/vapt_scans
